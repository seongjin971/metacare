{
  "expo": {
    "name": "메타케어 보호자",
    "slug": "metacare-caregiver",
    "scheme": "metacare-caregiver",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "../assets/metacare-icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metacare.caregiver",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "같은 네트워크의 복약 공유 서버에 연결할 때 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.metacare.caregiver",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "../assets/metacare-adaptive.png",
        "backgroundColor": "#208472"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "name": "메타케어 보호자",
      "favicon": "../assets/metacare-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6718d7b6-82af-439c-9c4e-7d09cde20061"
      }
    },
    "owner": "kwaksungjins-team"
  }
}
