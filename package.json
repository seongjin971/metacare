{
  "name": "metacare-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "workspaces": [
    "caregiver"
  ],
  "overrides": {
    "glob@^13": "14.0.3",
    "minimatch@^3": "$minimatch",
    "minimatch@^10": "11.0.4",
    "@vercel/oidc": {
      "@vercel/cli-config": "0.3.6"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vercel/queue": "0.11.0",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "minimatch": "file:tools/eslint-minimatch",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "expo lint",
    "export:web": "expo export --platform web",
    "export:public-web": "node scripts/export-public-web.cjs",
    "care:server": "node --experimental-strip-types server/care-server.ts",
    "care:migrate": "node --experimental-strip-types server/migrate-care.ts",
    "caregiver": "expo start --go --localhost --port 8082",
    "caregiver:web": "expo start --web --localhost --port 8082",
    "caregiver:typecheck": "npm run typecheck --workspace @metacare/caregiver"
  },
  "private": true
}
