{
  "expo": {
    "name": "메타케어",
    "slug": "metacare",
    "scheme": "metacare",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/metacare-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metacare.demo",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "같은 네트워크의 복약 공유 서버에 연결할 때 사용합니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.metacare.demo",
      "versionCode": 9,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/metacare-adaptive.png",
        "backgroundColor": "#3066e9"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/metacare-icon.png",
      "name": "메타케어",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-camera-capture.cjs",
      "./plugins/with-android-architectures.cjs",
      "./plugins/with-local-release-signing.cjs",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "복약 기록에 남길 사진을 촬영하기 위해 카메라를 사용합니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "metacare-private-reminders",
          "enableBackgroundRemoteNotifications": false,
          "color": "#3066e9"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "12d927c9-3d34-451b-b277-f08248d9b744"
      }
    },
    "owner": "kwaksungjins-team"
  }
}
