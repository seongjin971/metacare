{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["sin1"],
  "buildCommand": "tsc -p server/tsconfig.vercel.json && npm run care:migrate",
  "outputDirectory": "care-public",
  "functions": {
    "api/care.mjs": {
      "includeFiles": "care-runtime/**"
    },
    "api/overdue.mjs": {
      "includeFiles": "care-runtime/**",
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "metacare-overdue", "retryAfterSeconds": 30 }]
    }
  },
  "routes": [
    { "src": "^/v1/(.+)$", "dest": "/api/care?careRoute=$1" },
    { "handle": "filesystem" }
  ]
}
